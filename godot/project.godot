; GTIndian — Godot 4 project. See CLAUDE.md for commands and conventions.
config_version=5

[application]

config/name="GTIndian"
config/description="An open-world crime game set in an authentic Chennai."
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[autoload]

Settings="*res://scripts/core/settings.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=120
common/max_physics_steps_per_frame=12

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=0
anti_aliasing/quality/screen_space_aa=1
anti_aliasing/quality/use_taa=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
textures/default_filters/anisotropic_filtering_level=4
environment/defaults/default_clear_color=Color(0.5, 0.55, 0.6, 1)
textures/vram_compression/import_etc2_astc=true

[shader_globals]

night={
"type": "float",
"value": 0.0
}
hour={
"type": "float",
"value": 12.0
}
wet={
"type": "float",
"value": 0.0
}
power={
"type": "float",
"value": 1.0
}
wind={
"type": "vec3",
"value": Vector3(0.3, 0, 0.1)
}
